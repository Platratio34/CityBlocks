{
	"schemaVersion": 1,
	"id": "city-blocks",
	"version": "${mod_version}",
	"name": "City Blocks",
	"description": "Various Blocks for city construction",
	"authors": [
		"Platratio34"
	],
	"contact": {
		"homepage": "https://github.com/Platratio34/CityBlocks",
		"sources": "https://github.com/Platratio34/CityBlocks"
	},
	"license": "CC0-1.0",
	"icon": "assets/city-blocks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.peter.cityblocks.CityBlocks"
		],
		"client": [
			"com.peter.cityblocks.CityBlocksClient"
		],
        "fabric-datagen": [
            "com.peter.cityblocks.datagen.CityBlocksDataGenerator"
        ]
	},
	"mixins": [
		"city-blocks.mixins.json",
		{
			"config": "city-blocks.client.mixins.json",
			"environment": "client"
		}
	],
    "accessWidener": "city-blocks.accesswidener",
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=21",
		"fabric-api": "*",
		"computercraft": ">=${cct_version}"
	}
}